{
  "name": "MusicMakerLM",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "sudo apt-get install -y fluidsynth && pip install -r requirements.txt && cp -n .env.example .env",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "MusicMakerLM UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
